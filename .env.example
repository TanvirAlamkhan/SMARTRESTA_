# ====================================================================
# SMARTRESTA Environment Variable Configuration Template
# Copy this file to .env and fill in your Railway/MySQL credentials
# ====================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://smartresta.up.railway.app
APP_SECRET=replace_with_a_secure_random_hash_string
APP_TIMEZONE=Asia/Dhaka
SESSION_SECURE=true
LOG_LEVEL=info

# Database Credentials (Railway MySQL Variables)
DB_HOST=containers-us-west-123.railway.app
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=railway_generated_password
